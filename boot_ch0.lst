     1                                  [org 0x7C00]                    ; Tell NASM our code is loaded at physical 0x7C00
     2                                  [bits 16]                       ; Emit 16-bit Real Mode machine instructions
     3                                  
     4                                  _start:
     5                                      ; 1. Disable interrupts and normalize CS:IP to 0x0000:0x7C00
     6 00000000 FA                          cli                         ; Clear Interrupt Flag (IF = 0 in EFLAGS)
     7 00000001 FC                          cld                         ; Clear Direction Flag so string ops increment SI/DI
     8 00000002 EA[0700]0000                jmp 0x0000:.flush_cs        ; Far jump forces CS = 0x0000 regardless of BIOS
     9                                  
    10                                  .flush_cs:
    11 00000007 31C0                        xor ax, ax                  ; AX = 0x0000
    12 00000009 8ED8                        mov ds, ax                  ; Data Segment = 0x0000
    13 0000000B 8ED0                        mov ss, ax                  ; Stack Segment = 0x0000
    14 0000000D BC007C                      mov sp, 0x7C00              ; Stack grows safely downward from 0x7C00 toward 0x0500
    15                                  
    16                                      ; 2. Unlock the A20 Address Line via Fast A20 Gate (System Control Port 0x92)
    17 00000010 E492                        in al, 0x92                 ; Read current Port 0x92 state into AL
    18 00000012 0C02                        or al, 0b00000010           ; Set Bit 1 (A20 Enable)
    19 00000014 24FE                        and al, 0b11111110          ; Ensure Bit 0 (Fast Reset) stays 0!
    20 00000016 E692                        out 0x92, al                ; Write updated byte back to Port 0x92
    21                                  
    22                                      ; 3. Read Control Register CR0 into 32-bit EAX (Allowed in 16-bit Ring 0!)
    23 00000018 0F20C0                      mov eax, cr0                ; Inspect EAX in GDB: Bit 0 (PE) and Bit 31 (PG) are 0
    24                                  
    25                                      ; 4. Use Segmented Addressing to write directly to VGA RAM (0xB800:0x0000 = 0xB8000)
    26 0000001B BB00B8                      mov bx, 0xB800
    27 0000001E 8EC3                        mov es, bx                  ; Extra Segment (ES) = 0xB800
    28 00000020 31FF                        xor di, di                  ; Offset DI = 0x0000 -> ES:DI points to physical 0xB8000
    29 00000022 BE[3700]                    mov si, boot_msg            ; DS:SI points to our string at 0x0000:boot_msg
    30 00000025 B41F                        mov ah, 0x1F                ; Attribute: Bright White text (0xF) on Blue background (0x1)
    31                                  
    32                                  .print_vga:
    33 00000027 AC                          lodsb                       ; Load byte from [DS:SI] into AL and increment SI
    34 00000028 84C0                        test al, al                 ; Check for null terminator (0)
    35 0000002A 7408                        jz .spin_halt
    36 0000002C 268905                      mov [es:di], ax             ; Write 16-bit word (Color AH : Char AL) to [0xB800:DI]
    37 0000002F 83C702                      add di, 2                   ; Advance 2 bytes to next VGA character cell
    38 00000032 EBF3                        jmp .print_vga
    39                                  
    40                                  .spin_halt:
    41 00000034 F4                          hlt                         ; Ring 0 privileged halt instruction
    42 00000035 EBFD                        jmp .spin_halt
    43                                  
    44 00000037 4348313A205245414C-     boot_msg db "CH1: REAL MODE + A20 + CR0 VERIFIED", 0
    44 00000040 204D4F4445202B2041-
    44 00000049 3230202B2043523020-
    44 00000052 564552494649454400 
    45                                  
    46                                  ; Pad binary to 510 bytes and write the 2-byte 0xAA55 BIOS signature
    47 0000005B 00<rep 1A3h>            times 510 - ($ - $$) db 0
    48 000001FE 55AA                    dw 0xAA55
