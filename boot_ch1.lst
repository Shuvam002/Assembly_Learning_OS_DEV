     1                                  [org 0x7C00]
     2                                  [bits 16]
     3                                  
     4                                  _start:
     5                                      ; 1. Normalize 16-bit Real Mode segments and disable interrupts
     6 00000000 FA                          cli
     7 00000001 FC                          cld
     8 00000002 31C0                        xor ax, ax
     9 00000004 8ED8                        mov ds, ax
    10 00000006 8ED0                        mov ss, ax
    11 00000008 BC007C                      mov sp, 0x7C00
    12                                  
    13                                      ; 2. Unlock A20 line via Fast A20 port 0x92
    14 0000000B E492                        in al, 0x92
    15 0000000D 0C02                        or al, 0b00000010
    16 0000000F 24FE                        and al, 0b11111110
    17 00000011 E692                        out 0x92, al
    18                                  
    19                                      ; 3. Load the 48-bit GDTR register (16-bit limit + 32-bit base)
    20 00000013 0F0116[4000]                lgdt [gdt_descriptor]
    21                                  
    22                                      ; 4. Enable 32-bit Protected Mode by setting Bit 0 (PE) in CR0
    23 00000018 0F20C0                      mov eax, cr0
    24 0000001B 6683C801                    or eax, 0x00000001
    25 0000001F 0F22C0                      mov cr0, eax
    26                                  
    27                                      ; 5. Far jump loads CS with 0x08 (GDT Index 1) and flushes pipeline
    28 00000022 EA[4600]0800                jmp 0x08:init_pm
    29                                  
    30                                  ; -----------------------------------------------------------------------------
    31                                  ; Global Descriptor Table (GDT)
    32                                  ; -----------------------------------------------------------------------------
    33 00000027 90                      align 8
    34                                  gdt_start:
    35                                      ; Index 0 (Selector 0x00): Mandatory 8-byte Null Descriptor
    36 00000028 0000000000000000            dq 0x0000000000000000
    37                                  
    38                                  gdt_code:
    39                                      ; Index 1 (Selector 0x08): 32-Bit Ring 0 Flat Code Segment (0x00000000 - 0xFFFFFFFF)
    40 00000030 FFFF                        dw 0xFFFF                   ; Limit (bits 0-15)
    41 00000032 0000                        dw 0x0000                   ; Base (bits 0-15)
    42 00000034 00                          db 0x00                     ; Base (bits 16-23)
    43 00000035 9A                          db 10011010b                ; Access (0x9A): P=1, DPL=00, S=1, E=1, DC=0, RW=1, A=0
    44 00000036 CF                          db 11001111b                ; Flags (0xCF): G=1 (4KB), DB=1 (32-bit), L=0 + Limit (16-19)
    45 00000037 00                          db 0x00                     ; Base (bits 24-31)
    46                                  
    47                                  gdt_data:
    48                                      ; Index 2 (Selector 0x10): 32-Bit Ring 0 Flat Data Segment (0x00000000 - 0xFFFFFFFF)
    49 00000038 FFFF                        dw 0xFFFF                   ; Limit (bits 0-15)
    50 0000003A 0000                        dw 0x0000                   ; Base (bits 0-15)
    51 0000003C 00                          db 0x00                     ; Base (bits 16-23)
    52 0000003D 92                          db 10010010b                ; Access (0x92): P=1, DPL=00, S=1, E=0, DC=0, RW=1, A=0
    53 0000003E CF                          db 11001111b                ; Flags (0xCF): G=1 (4KB), DB=1 (32-bit), L=0 + Limit (16-19)
    54 0000003F 00                          db 0x00                     ; Base (bits 24-31)
    55                                  gdt_end:
    56                                  
    57                                  gdt_descriptor:
    58 00000040 1700                        dw gdt_end - gdt_start - 1  ; Size of GDT in bytes minus 1 (24 - 1 = 23)
    59 00000042 [28000000]                  dd gdt_start                ; 32-bit physical base address of gdt_start
    60                                  
    61                                  ; -----------------------------------------------------------------------------
    62                                  ; 32-Bit Protected Mode Entry Point
    63                                  ; -----------------------------------------------------------------------------
    64                                  [bits 32]
    65                                  init_pm:
    66                                      ; 6. Reload all data and stack segment registers with Data Selector 0x10
    67 00000046 66B81000                    mov ax, 0x10
    68 0000004A 8ED8                        mov ds, ax
    69 0000004C 8ED0                        mov ss, ax
    70 0000004E 8EC0                        mov es, ax
    71 00000050 8EE0                        mov fs, ax
    72 00000052 8EE8                        mov gs, ax
    73 00000054 BC00000900                  mov esp, 0x90000            ; Set 32-bit Stack Pointer in free RAM at 0x90000
    74                                  
    75                                      ; 7. Flat 32-Bit Addressing: Write directly to 0xB8000 without segment math!
    76 00000059 BF00800B00                  mov edi, 0xB8000            ; Direct 32-bit physical pointer to VGA memory
    77 0000005E BE[75000000]                mov esi, pm_msg             ; Direct 32-bit pointer to string
    78 00000063 B40E                        mov ah, 0x0E                ; Color: Yellow text (0xE) on Black background (0x0)
    79                                  
    80                                  .loop_vga:
    81 00000065 AC                          lodsb                       ; Load byte from [ESI] into AL, increment ESI
    82 00000066 84C0                        test al, al
    83 00000068 7408                        jz .halt
    84 0000006A 668907                      mov [edi], ax               ; Flat 32-bit write to [0xB8000 + offset]
    85 0000006D 83C702                      add edi, 2
    86 00000070 EBF3                        jmp .loop_vga
    87                                  
    88                                  .halt:
    89 00000072 F4                          hlt
    90 00000073 EBFD                        jmp .halt
    91                                  
    92 00000075 4348313A2033322D42-     pm_msg db "CH1: 32-BIT PROTECTED MODE + FLAT GDT ACTIVE", 0
    92 0000007E 49542050524F544543-
    92 00000087 544544204D4F444520-
    92 00000090 2B20464C4154204744-
    92 00000099 542041435449564500 
    93                                  
    94 000000A2 00<rep 15Ch>            times 510 - ($ - $$) db 0
    95 000001FE 55AA                    dw 0xAA55
